{
  "name": "next-sidebars",
  "version": "0.1.3",
  "description": "Persisted sidebar state for Next.js, applied before first paint",
  "keywords": [
    "cache-components",
    "localstorage",
    "next",
    "nextjs",
    "persistence",
    "react",
    "shadcn",
    "sidebar",
    "sidebars"
  ],
  "homepage": "https://github.com/andreastande/next-sidebars#readme",
  "bugs": "https://github.com/andreastande/next-sidebars/issues",
  "license": "MIT",
  "author": "Andreas Tande <andreas.tande@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreastande/next-sidebars.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "release": "pnpm build && changeset publish",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
